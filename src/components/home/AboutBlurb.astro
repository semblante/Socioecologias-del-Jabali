---
import type { Locale } from '../../config/site';
import { getUi } from '../../i18n/ui';
import { localizedPath } from '../../i18n/routing';
import { textWithSpecies } from '../../lib/markdown';
import SiteLogo from '../identity/SiteLogo.astro';

interface Props {
  locale: Locale;
  summary: string;
}

const { locale, summary } = Astro.props;
const ui = getUi(locale);

const frameworks =
  locale === 'es'
    ? ['Ecología de conservación', 'Antropología', 'STS', 'Kimün mapuche']
    : ['Conservation ecology', 'Anthropology', 'STS', 'Mapuche kimün'];
---

<section class="about">
  <div class="about__inner container">
    <div class="about__brand">
      <SiteLogo locale={locale} size="hero" class="about__seal" />
    </div>
    <p class="about__label">{ui.aboutProject}</p>
    <p class="about__statement" set:html={textWithSpecies(summary)} />
    <ul class="about__lenses">
      {frameworks.map((fw) => (
        <li>{fw}</li>
      ))}
    </ul>
    <a class="about__link" href={localizedPath('/proyecto', locale)}>{ui.readMore} →</a>
  </div>
</section>

<style>
  .about {
    position: relative;
    padding-block: clamp(3.5rem, 10vw, 6.5rem);
    border-bottom: 1px solid var(--color-border);
    /* transparente: un fondo sólido tapa site-topo (z-index bajo main) */
    background: transparent;
  }

  .about__inner {
    display: grid;
    gap: var(--s-6);
    max-width: 52rem;
  }

  .about__brand {
    margin-bottom: var(--s-2);
  }

  .about__seal {
    width: min(7.5rem, 36vw);
    max-width: 7.5rem;
    opacity: 1;
    color: var(--color-text);
  }

  .about__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .about__statement {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .about__lenses {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about__lenses li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .about__lenses li::before {
    content: "·";
    margin-right: 0.65rem;
    color: var(--color-accent);
  }

  .about__lenses li:first-child::before {
    content: none;
    margin: 0;
  }

  .about__link {
    justify-self: start;
    font-size: var(--t-sm);
    font-weight: 500;
    text-decoration: none;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 0.15em;
  }

  .about__link:hover {
    color: var(--color-accent);
  }
</style>
