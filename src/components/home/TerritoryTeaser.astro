---
import type { Locale } from '../../config/site';
import SiteMap from '../territorio/SiteMap.astro';
import { getSitios, getEntrySlug } from '../../lib/content';
import { localizedPath } from '../../i18n/routing';
import { parseCoords } from '../../lib/geo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const sitios = await getSitios(locale);

const markers = sitios
  .map((s) => {
    const coords = parseCoords(s.data.coordenadas);
    if (!coords) return null;
    return {
      id: getEntrySlug(s),
      nombre: s.data.nombre,
      lat: coords.lat,
      lng: coords.lng,
      tipo: s.data.tipo as 'principal' | 'secundario',
      href: localizedPath(`/territorio/${getEntrySlug(s)}`, locale),
      aporte: s.data.aporte,
    };
  })
  .filter((m): m is NonNullable<typeof m> => m !== null);

const title = locale === 'es' ? 'Territorio de trabajo' : 'Field territory';
const lead =
  locale === 'es'
    ? 'Cuatro sitios en el corredor volcánico de la Araucanía andina, con Puesco-Lanín como eje y el Acuerdo Winkulmapu sobre 17.000 hectáreas.'
    : 'Four sites along the Andean Araucanía volcanic corridor, with Puesco-Lanín at the core and the Winkulmapu Agreement covering 17,000 hectares.';
---

{markers.length > 0 && (
  <section class="terra">
    <div class="container">
      <div class="terra__copy">
        <p class="terra__label">{locale === 'es' ? 'Peweñantu' : 'Peweñantu'}</p>
        <h2 class="terra__title">{title}</h2>
        <p class="terra__lead">{lead}</p>
        <a class="terra__link" href={localizedPath('/territorio', locale)}>
          {locale === 'es' ? 'Explorar el territorio →' : 'Explore the territory →'}
        </a>
      </div>
      <div class="terra__map">
        <SiteMap markers={markers} locale={locale} height="min(38vh, 22rem)" />
      </div>
    </div>
  </section>
)}

<style>
  .terra {
    padding-block: clamp(3rem, 8vw, 5rem);
    background: transparent;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .terra .container {
    display: grid;
    gap: var(--s-8);
    align-items: end;
  }

  @media (min-width: 768px) {
    .terra .container {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: var(--s-12);
    }
  }

  .terra__label {
    margin: 0 0 var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .terra__title {
    margin: 0 0 var(--s-4);
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .terra__lead {
    margin: 0 0 var(--s-6);
    max-width: 36ch;
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .terra__link {
    font-size: var(--t-sm);
    font-weight: 500;
    text-decoration: none;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 0.1em;
  }

  .terra__link:hover {
    color: var(--color-accent);
  }
</style>
