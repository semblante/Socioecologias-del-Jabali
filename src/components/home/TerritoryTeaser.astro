---
import type { Locale } from '../../config/site';
import SiteMap from '../territorio/SiteMap.astro';
import { getSitios, getEntrySlug } from '../../lib/content';
import { localizedPath } from '../../i18n/routing';
import { parseCoords } from '../../lib/geo';

interface Props {
  locale: Locale;
  /** paginas → territorio → description; si falta, texto de respaldo. */
  lead?: string;
}

const { locale } = Astro.props;
const sitios = await getSitios(locale);

const markers = sitios
  .map((s) => {
    const coords = parseCoords(s.data.coordenadas);
    if (!coords) return null;
    return {
      id: getEntrySlug(s),
      nombre: s.data.nombre,
      lat: coords.lat,
      lng: coords.lng,
      tipo: s.data.tipo as 'principal' | 'secundario',
      href: localizedPath(`/territorio/${getEntrySlug(s)}`, locale),
      aporte: s.data.aporte,
    };
  })
  .filter((m): m is NonNullable<typeof m> => m !== null);

const title = locale === 'es' ? 'Territorio de trabajo' : 'Field territory';
const lead =
  Astro.props.lead?.trim() ||
  (locale === 'es'
    ? 'Cuatro sitios en el corredor volcánico de la Araucanía andina, con Puesco-Lanín como eje y el Acuerdo Winkulmapu sobre 17.000 hectáreas.'
    : 'Four sites along the Andean Araucanía volcanic corridor, with Puesco-Lanín at the core and the Winkulmapu Agreement covering 17,000 hectares.');
---

{markers.length > 0 && (
  <section class="terra">
    <div class="container">
      <header class="terra__head">
        <p class="section-mark">Peweñantu · Kurarewe</p>
        <h2 class="display-title terra__title">{title}</h2>
        <div class="terra__row">
          <p class="terra__lead">{lead}</p>
          <a class="link-line terra__link" href={localizedPath('/territorio', locale)}>
            {locale === 'es' ? 'Explorar el territorio' : 'Explore the territory'} <span class="link-line__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </header>
      <SiteMap markers={markers} locale={locale} height="min(62vh, 36rem)" showZone />
    </div>
  </section>
)}

<style>
  .terra {
    padding-block: clamp(4rem, 10vw, 7rem);
    background: transparent;
    border-bottom: 1px solid var(--color-border);
  }

  .terra__head {
    display: grid;
    gap: var(--s-6);
    margin-bottom: clamp(var(--s-8), 4vw, var(--s-12));
  }

  .terra__row {
    display: grid;
    gap: var(--s-4) var(--s-12);
    padding-top: var(--s-6);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .terra__row {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }

  .terra__lead {
    margin: 0;
    max-width: 52ch;
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    line-height: 1.45;
    color: var(--color-text);
  }

  .terra__link {
    justify-self: start;
    white-space: nowrap;
  }
</style>
