---
import type { Locale } from '../../config/site';
import { siteConfig } from '../../config/site';
import { getUi } from '../../i18n/ui';
import { localizedPath } from '../../i18n/routing';
import { textWithSpecies } from '../../lib/markdown';

interface Props {
  locale: Locale;
  tagline: string;
  intro: string;
  heroMedia?: string;
}

const { locale, tagline, intro, heroMedia = '' } = Astro.props;
const ui = getUi(locale);
const brand = siteConfig.nameShort[locale];

function parseHeroSources(raw: string): string[] {
  return raw
    .split(',')
    .map((s) => s.trim())
    .filter(Boolean);
}

// ponytail: rutas locales o URLs directas; YouTube/Vimeo exigirían iframe aparte
const heroSources = parseHeroSources(heroMedia);
const mediaKind = (() => {
  if (!heroSources.length) return null;
  if (heroSources.every((src) => /\.(mp4|webm|ogg)(\?|$)/i.test(src))) return 'video' as const;
  if (heroSources.length === 1) return 'image' as const;
  return null;
})();
---

<section
  class="hero"
  aria-label={brand}
  data-home-hero
  data-has-media={mediaKind ? 'true' : 'false'}
  data-hero-sources={mediaKind === 'video' ? heroSources.join(',') : undefined}
>
  <div class="hero__atmosphere" aria-hidden="true"></div>

  {mediaKind === 'video' && (
    <>
      <div class="hero__media-frame" aria-hidden="true">
        <video
          class="hero__media hero__media--video is-active"
          data-hero-video
          src={heroSources[0]}
          muted
          playsinline
          preload="auto"
        ></video>
        {heroSources.length > 1 && (
          <video class="hero__media hero__media--video" data-hero-video muted playsinline preload="none"></video>
        )}
        <div class="hero__media-tint" aria-hidden="true"></div>
      </div>
      <p class="hero__credit">{ui.hero.footageCredit}</p>
    </>
  )}
  {mediaKind === 'image' && (
    <img class="hero__media hero__media--still" src={heroSources[0]} alt="" aria-hidden="true" />
  )}

  <div class="hero__veil" aria-hidden="true"></div>

  <div class="hero__inner">
    <div class="hero__copy">
      <p class="hero__kicker">{siteConfig.fondecyt} · {siteConfig.fondecytYear}</p>
      <h1 class="hero__title">{tagline}</h1>
      <p class="hero__intro" set:html={textWithSpecies(intro)} />
      <div class="hero__actions">
        <a class="hero__cta hero__cta--solid" href={localizedPath('/proyecto', locale)}>{ui.projectCta}</a>
        <a class="hero__cta hero__cta--ghost" href={localizedPath('/cuaderno', locale)}>{ui.fieldNotesCta}</a>
      </div>
    </div>
  </div>
</section>

{mediaKind === 'video' && (
  <script>
    function initHeroVideo() {
      const hero = document.querySelector('[data-home-hero]');
      if (!hero || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const sources = (hero.getAttribute('data-hero-sources') || '')
        .split(',')
        .map((s) => s.trim())
        .filter(Boolean);
      const videos = [...hero.querySelectorAll('[data-hero-video]')];
      if (!sources.length || !videos.length) return;

      if (window.__heroVideoRaf) {
        cancelAnimationFrame(window.__heroVideoRaf);
        window.__heroVideoRaf = 0;
      }

      let sourceIdx = 0;
      let activeLayer = 0;
      let forward = true;
      let last = 0;
      const speed = 0.86;

      function layerVideo(layer) {
        return videos[layer] || videos[0];
      }

      function setActiveLayer(layer) {
        videos.forEach((video, i) => video.classList.toggle('is-active', i === layer));
      }

      function loadVideo(video, src) {
        if (video.dataset.loadedSrc === src && video.readyState >= 1) {
          return Promise.resolve();
        }
        video.dataset.loadedSrc = src;
        video.src = src;
        video.load();
        if (video.readyState >= 1) return Promise.resolve();
        return new Promise((resolve) => video.addEventListener('loadedmetadata', resolve, { once: true }));
      }

      function preloadNext(fromIdx) {
        if (sources.length < 2 || videos.length < 2) return;
        const nextIdx = (fromIdx + 1) % sources.length;
        const inactiveLayer = 1 - activeLayer;
        loadVideo(layerVideo(inactiveLayer), sources[nextIdx]);
      }

      function tick(t) {
        const video = layerVideo(activeLayer);
        if (!last) last = t;
        const dt = ((t - last) / 1000) * speed;
        last = t;

        const dur = video.duration;
        if (!dur || !Number.isFinite(dur)) {
          window.__heroVideoRaf = requestAnimationFrame(tick);
          return;
        }

        if (forward) {
          video.currentTime = Math.min(dur, video.currentTime + dt);
          if (video.currentTime >= dur - 0.05) forward = false;
        } else {
          video.currentTime = Math.max(0, video.currentTime - dt);
          if (video.currentTime <= 0.05) {
            forward = true;
            if (sources.length > 1 && videos.length > 1) {
              sourceIdx = (sourceIdx + 1) % sources.length;
              activeLayer = 1 - activeLayer;
              last = 0;
              loadVideo(layerVideo(activeLayer), sources[sourceIdx]).then(() => {
                layerVideo(activeLayer).currentTime = 0;
                setActiveLayer(activeLayer);
                preloadNext(sourceIdx);
                window.__heroVideoRaf = requestAnimationFrame(tick);
              });
              return;
            }
          }
        }

        window.__heroVideoRaf = requestAnimationFrame(tick);
      }

      videos.forEach((video) => video.pause());
      setActiveLayer(0);
      loadVideo(layerVideo(0), sources[0]).then(() => {
        layerVideo(0).currentTime = 0;
        preloadNext(0);
        window.__heroVideoRaf = requestAnimationFrame(tick);
      });
    }

    initHeroVideo();
    document.addEventListener('astro:page-load', initHeroVideo);
  </script>
)}

<style>
  /* Colores literales: evita que un token roto deje el hero crema/negro. */
  .hero {
    --hero-ink: #0c0c0e;
    --hero-cream: #f5f2e8;
    --hero-accent: #b6573e;
    position: relative;
    isolation: isolate;
    min-height: min(96vh, 56rem);
    display: flex;
    align-items: flex-end;
    color: var(--hero-cream);
    background: var(--hero-ink);
    overflow: hidden;
  }

  .hero__atmosphere {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 100% 75% at 8% 100%, rgba(182, 87, 62, 0.38), transparent 58%),
      radial-gradient(ellipse 60% 45% at 92% 8%, rgba(245, 242, 232, 0.07), transparent 55%),
      linear-gradient(168deg, #070708 0%, #141210 42%, #1f1a16 100%);
  }

  .hero__atmosphere::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--texture-grain);
    background-size: 180px 180px;
    opacity: 0.22;
    mix-blend-mode: soft-light;
  }

  .hero[data-has-media='true'] .hero__atmosphere {
    opacity: 0.28;
  }

  /*
    Ventana 16:9 contenida (no full-bleed).
    Los clips son 848×480 H.264 — formato web correcto; el “pegado” venía del cover.
  */
  .hero__media-frame {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    pointer-events: none;
    /* Empuja el plano hacia arriba para dejar aire bajo el copy */
    padding: clamp(4.5rem, 12vh, 7rem) clamp(1.25rem, 5vw, 4rem) clamp(7rem, 22vh, 12rem);
  }

  .hero__media {
    width: min(100%, 56rem);
    height: auto;
    max-height: min(52vh, 28rem);
    aspect-ratio: 16 / 9;
    object-fit: contain;
    object-position: center center;
    pointer-events: none;
    /* Leve viñeta propia del marco, como pantalla de cámara */
    box-shadow:
      0 0 0 1px rgba(245, 242, 232, 0.08),
      0 1.5rem 3rem rgba(0, 0, 0, 0.45);
  }

  .hero__media--still {
    width: min(100%, 56rem);
    max-height: min(52vh, 28rem);
    object-fit: contain;
  }

  .hero__media--video {
    opacity: 0;
    transition: opacity 1.6s ease;
    will-change: opacity;
  }

  .hero__media--video.is-active {
    opacity: 1;
  }

  .hero__media-tint {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: color;
    opacity: 0.85;
    animation: hero-field-tint 28s ease-in-out infinite alternate;
  }

  @keyframes hero-field-tint {
    0% {
      background: rgba(36, 78, 58, 0.42);
    }
    50% {
      background: rgba(118, 72, 44, 0.34);
    }
    100% {
      background: rgba(34, 52, 68, 0.38);
    }
  }

  .hero__credit {
    position: absolute;
    right: clamp(1.25rem, 3.5vw, 2.25rem);
    bottom: clamp(1.35rem, 3.5vh, 2rem);
    z-index: 2;
    margin: 0;
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(245, 242, 232, 0.42);
    pointer-events: none;
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(7, 7, 8, 0.12) 0%, rgba(7, 7, 8, 0.2) 42%, rgba(7, 7, 8, 0.78) 100%),
      linear-gradient(90deg, rgba(7, 7, 8, 0.35) 0%, transparent 42%);
  }

  .hero:not([data-has-media='true']) .hero__veil {
    background: transparent;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    width: min(100% - 2.5rem, var(--w-wide, 1120px));
    margin-inline: auto;
    padding-block: clamp(5.5rem, 14vh, 8rem) clamp(4rem, 11vh, 6.5rem);
    padding-inline: 0.25rem;
    box-sizing: border-box;
  }

  @media (max-width: 639px) {
    .hero__inner {
      width: min(100% - 1.5rem, var(--w-wide, 1120px));
      padding-bottom: clamp(4.5rem, 12vh, 6rem);
    }

    .hero__media-frame {
      padding: clamp(3.5rem, 10vh, 5rem) 0.85rem clamp(6rem, 20vh, 9rem);
    }

    .hero__media,
    .hero__media--still {
      width: min(100%, 40rem);
      max-height: min(42vh, 22rem);
    }
  }

  .hero__copy {
    max-width: 40rem;
    animation: hero-rise 900ms var(--ease-organic, cubic-bezier(0.22, 0.61, 0.36, 1)) both;
  }

  .hero__kicker {
    margin: 0 0 var(--s-4, 1rem);
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hero-accent);
  }

  .hero__title {
    margin: 0 0 var(--s-6, 1.5rem);
    font-family: var(--font-serif, "Newsreader", Georgia, serif);
    font-size: clamp(1.85rem, 4.6vw, 3.05rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 18ch;
    color: var(--hero-cream);
  }

  .hero__intro {
    margin: 0 0 var(--s-8, 2rem);
    max-width: 42ch;
    font-family: var(--font-sans, "Instrument Sans", system-ui, sans-serif);
    font-size: clamp(1.02rem, 1.55vw, 1.18rem);
    line-height: 1.65;
    color: rgba(245, 242, 232, 0.78);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 1.4rem;
    font-family: var(--font-sans, "Instrument Sans", system-ui, sans-serif);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      background 180ms ease,
      color 180ms ease,
      border-color 180ms ease;
  }

  .hero__cta--solid {
    background: var(--hero-cream);
    color: var(--hero-ink);
    border-color: var(--hero-cream);
  }

  .hero__cta--solid:hover {
    background: #fff8ea;
    color: var(--hero-ink);
  }

  .hero__cta--ghost {
    background: transparent;
    color: var(--hero-cream);
    border-color: rgba(245, 242, 232, 0.38);
  }

  .hero__cta--ghost:hover {
    border-color: var(--hero-cream);
    background: rgba(245, 242, 232, 0.08);
    color: var(--hero-cream);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(1.15rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__copy {
      animation: none;
    }

    .hero__media-tint {
      animation: none;
      background: rgba(36, 78, 58, 0.35);
    }

    .hero__media--video {
      transition: none;
    }

    .hero video.hero__media {
      display: none;
    }

    .hero__credit {
      display: none;
    }
  }

  @media (max-width: 639px) {
    .hero {
      min-height: min(90vh, 42rem);
    }

    .hero__title {
      max-width: 20ch;
    }
  }
</style>
