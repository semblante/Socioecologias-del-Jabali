---
import type { Locale } from '../../config/site';
import { siteConfig } from '../../config/site';
import { getUi } from '../../i18n/ui';
import { localizedPath } from '../../i18n/routing';
import { textWithSpecies } from '../../lib/markdown';

interface Props {
  locale: Locale;
  tagline: string;
  intro: string;
  heroMedia?: string;
}

const { locale, tagline, intro, heroMedia = '' } = Astro.props;
const ui = getUi(locale);
const brand = siteConfig.nameShort[locale];

// ponytail: solo archivo directo; YouTube/Vimeo exigirían iframe aparte
const mediaKind = (() => {
  if (!heroMedia.trim()) return null;
  if (/\.(mp4|webm|ogg)(\?|$)/i.test(heroMedia)) return 'video' as const;
  return 'image' as const;
})();
---

<section class="hero" aria-label={brand} data-home-hero data-has-media={mediaKind ? 'true' : 'false'}>
  <div class="hero__atmosphere" aria-hidden="true"></div>

  {mediaKind === 'video' && (
    <video
      class="hero__media"
      src={heroMedia}
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
    ></video>
  )}
  {mediaKind === 'image' && (
    <img class="hero__media" src={heroMedia} alt="" aria-hidden="true" />
  )}

  <div class="hero__veil" aria-hidden="true"></div>

  <div class="hero__inner">
    <div class="hero__copy">
      <p class="hero__kicker">{siteConfig.fondecyt} · {siteConfig.fondecytYear}</p>
      <h1 class="hero__title">{tagline}</h1>
      <p class="hero__intro" set:html={textWithSpecies(intro)} />
      <div class="hero__actions">
        <a class="hero__cta hero__cta--solid" href={localizedPath('/proyecto', locale)}>{ui.projectCta}</a>
        <a class="hero__cta hero__cta--ghost" href={localizedPath('/cuaderno', locale)}>{ui.fieldNotesCta}</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Colores literales: evita que un token roto deje el hero crema/negro. */
  .hero {
    --hero-ink: #0c0c0e;
    --hero-cream: #f5f2e8;
    --hero-accent: #b6573e;
    position: relative;
    isolation: isolate;
    min-height: min(94vh, 54rem);
    display: flex;
    align-items: flex-end;
    color: var(--hero-cream);
    background: var(--hero-ink);
    overflow: hidden;
  }

  .hero__atmosphere {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 100% 75% at 8% 100%, rgba(182, 87, 62, 0.38), transparent 58%),
      radial-gradient(ellipse 60% 45% at 92% 8%, rgba(245, 242, 232, 0.07), transparent 55%),
      linear-gradient(168deg, #070708 0%, #141210 42%, #1f1a16 100%);
  }

  .hero__atmosphere::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--texture-grain);
    background-size: 180px 180px;
    opacity: 0.22;
    mix-blend-mode: soft-light;
  }

  .hero[data-has-media='true'] .hero__atmosphere {
    opacity: 0.35;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(7, 7, 8, 0.25) 0%, rgba(7, 7, 8, 0.55) 45%, rgba(7, 7, 8, 0.88) 100%),
      linear-gradient(90deg, rgba(7, 7, 8, 0.55) 0%, transparent 55%);
  }

  .hero:not([data-has-media='true']) .hero__veil {
    background: transparent;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    width: min(100% - 2.5rem, var(--w-wide, 1120px));
    margin-inline: auto;
    padding-block: clamp(5.5rem, 14vh, 8rem) clamp(3.25rem, 9vh, 5.5rem);
    padding-inline: 0.25rem;
    box-sizing: border-box;
  }

  @media (max-width: 639px) {
    .hero__inner {
      width: min(100% - 1.5rem, var(--w-wide, 1120px));
    }
  }

  .hero__copy {
    max-width: 40rem;
    animation: hero-rise 900ms var(--ease-organic, cubic-bezier(0.22, 0.61, 0.36, 1)) both;
  }

  .hero__kicker {
    margin: 0 0 var(--s-4, 1rem);
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hero-accent);
  }

  .hero__title {
    margin: 0 0 var(--s-6, 1.5rem);
    font-family: var(--font-serif, "Newsreader", Georgia, serif);
    font-size: clamp(1.85rem, 4.6vw, 3.05rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 18ch;
    color: var(--hero-cream);
  }

  .hero__intro {
    margin: 0 0 var(--s-8, 2rem);
    max-width: 42ch;
    font-family: var(--font-sans, "Instrument Sans", system-ui, sans-serif);
    font-size: clamp(1.02rem, 1.55vw, 1.18rem);
    line-height: 1.65;
    color: rgba(245, 242, 232, 0.78);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 1.4rem;
    font-family: var(--font-sans, "Instrument Sans", system-ui, sans-serif);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      background 180ms ease,
      color 180ms ease,
      border-color 180ms ease;
  }

  .hero__cta--solid {
    background: var(--hero-cream);
    color: var(--hero-ink);
    border-color: var(--hero-cream);
  }

  .hero__cta--solid:hover {
    background: #fff8ea;
    color: var(--hero-ink);
  }

  .hero__cta--ghost {
    background: transparent;
    color: var(--hero-cream);
    border-color: rgba(245, 242, 232, 0.38);
  }

  .hero__cta--ghost:hover {
    border-color: var(--hero-cream);
    background: rgba(245, 242, 232, 0.08);
    color: var(--hero-cream);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(1.15rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__copy {
      animation: none;
    }

    .hero video.hero__media {
      display: none;
    }
  }

  @media (max-width: 639px) {
    .hero {
      min-height: min(88vh, 40rem);
    }

    .hero__title {
      max-width: 20ch;
    }
  }
</style>
