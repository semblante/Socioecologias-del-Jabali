---
import type { Locale } from '../../config/site';
import { siteConfig } from '../../config/site';
import { getUi } from '../../i18n/ui';
import { localizedPath } from '../../i18n/routing';
import { textWithSpecies } from '../../lib/markdown';

interface Props {
  locale: Locale;
  tagline: string;
  intro: string;
  heroMedia?: string;
}

const { locale, tagline, intro, heroMedia = '' } = Astro.props;
const ui = getUi(locale);
const brand = siteConfig.nameShort[locale];

function parseHeroSources(raw: string): string[] {
  return raw
    .split(',')
    .map((s) => s.trim())
    .filter(Boolean);
}

// ponytail: rutas locales o URLs directas; YouTube/Vimeo exigirían iframe aparte
const heroSources = parseHeroSources(heroMedia);
const mediaKind = (() => {
  if (!heroSources.length) return null;
  if (heroSources.every((src) => /\.(mp4|webm|ogg)(\?|$)/i.test(src))) return 'video' as const;
  if (heroSources.length === 1) return 'image' as const;
  return null;
})();
const hasPlaylist = mediaKind === 'video' && heroSources.length > 1;
---

<section
  class="hero"
  aria-label={brand}
  data-home-hero
  data-has-media={mediaKind ? 'true' : 'false'}
  data-hero-sources={mediaKind === 'video' ? heroSources.join(',') : undefined}
>
  <div class="hero__atmosphere" aria-hidden="true"></div>

  {mediaKind === 'video' && (
    <>
      <div class="hero__media-frame" aria-hidden="true">
        <div class="hero__media-stack">
          <video
            class="hero__media hero__media--video is-active"
            data-hero-video
            src={heroSources[0]}
            muted
            playsinline
            preload="auto"
          ></video>
          {hasPlaylist && (
            <video class="hero__media hero__media--video" data-hero-video muted playsinline preload="none"></video>
          )}
        </div>
        <div class="hero__media-tint" aria-hidden="true"></div>
        <div class="hero__media-psych" aria-hidden="true"></div>
      </div>
      <p class="hero__credit">{ui.hero.footageCredit}</p>
    </>
  )}
  {mediaKind === 'image' && (
    <img class="hero__media hero__media--still" src={heroSources[0]} alt="" aria-hidden="true" />
  )}

  <div class="hero__veil" aria-hidden="true"></div>

  <div class="hero__inner">
    <div class="hero__copy">
      <p class="hero__kicker">{siteConfig.fondecyt} · {siteConfig.fondecytYear}</p>
      <h1 class="hero__title">{tagline}</h1>
      <p class="hero__intro" set:html={textWithSpecies(intro)} />
      <div class="hero__actions">
        <a class="hero__cta hero__cta--solid" href={localizedPath('/proyecto', locale)}>{ui.projectCta}</a>
        <a class="hero__cta hero__cta--ghost" href={localizedPath('/cuaderno', locale)}>{ui.fieldNotesCta}</a>
      </div>
    </div>
  </div>
</section>

{mediaKind === 'video' && (
  <script>
    function initHeroVideo() {
      const hero = document.querySelector('[data-home-hero]');
      if (!hero || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const sources = (hero.getAttribute('data-hero-sources') || '')
        .split(',')
        .map((s) => s.trim())
        .filter(Boolean);
      const videos = [...hero.querySelectorAll('[data-hero-video]')];
      if (!sources.length || !videos.length) return;

      // ClientRouter dispara astro:page-load también en la carga inicial.
      // Si ya vivimos en este nodo, no re-init (evita el reinicio a los ~2s).
      if (hero.dataset.heroVideoLive === '1') return;

      if (typeof window.__heroVideoCleanup === 'function') {
        window.__heroVideoCleanup();
        window.__heroVideoCleanup = null;
      }

      hero.dataset.heroVideoLive = '1';

      const FADE_MS = 1500;
      const LEAD_S = 1.55;
      let sourceIdx = 0;
      let activeLayer = 0;
      let switching = false;
      /** @type {number[]} */
      const timers = [];
      /** @type {Array<() => void>} */
      const cleanups = [];

      function layerVideo(layer) {
        return videos[layer] || videos[0];
      }

      function setActiveLayer(layer) {
        videos.forEach((video, i) => video.classList.toggle('is-active', i === layer));
      }

      function resolvedSrc(video) {
        return video.dataset.loadedSrc || video.getAttribute('src') || '';
      }

      function loadVideo(video, src) {
        // No llamar load() si ya es el mismo src (p. ej. markup inicial):
        // eso reinicia el buffer y se ve como un salto al inicio.
        if (resolvedSrc(video) === src) {
          video.dataset.loadedSrc = src;
          if (video.readyState >= 1) return Promise.resolve();
          return new Promise((resolve) => video.addEventListener('loadedmetadata', resolve, { once: true }));
        }
        video.dataset.loadedSrc = src;
        video.src = src;
        video.load();
        if (video.readyState >= 1) return Promise.resolve();
        return new Promise((resolve) => video.addEventListener('loadedmetadata', resolve, { once: true }));
      }

      async function playSrc(layer, src, { restart = true } = {}) {
        const video = layerVideo(layer);
        await loadVideo(video, src);
        if (restart) {
          try {
            video.currentTime = 0;
          } catch (_) {
            /* ignore seek before ready */
          }
        }
        try {
          await video.play();
        } catch (_) {
          /* autoplay policies / reduced data */
        }
      }

      function preloadNext() {
        if (sources.length < 2 || videos.length < 2) return;
        const nextIdx = (sourceIdx + 1) % sources.length;
        loadVideo(layerVideo(1 - activeLayer), sources[nextIdx]);
      }

      async function beginCrossfade() {
        if (switching || sources.length < 2 || videos.length < 2) return;
        switching = true;

        const nextIdx = (sourceIdx + 1) % sources.length;
        const nextLayer = 1 - activeLayer;
        const prevLayer = activeLayer;

        await playSrc(nextLayer, sources[nextIdx], { restart: true });
        setActiveLayer(nextLayer);

        const done = window.setTimeout(() => {
          layerVideo(prevLayer).pause();
          sourceIdx = nextIdx;
          activeLayer = nextLayer;
          switching = false;
          preloadNext();
        }, FADE_MS);
        timers.push(done);
      }

      function onActiveProgress(event) {
        if (switching || sources.length < 2 || videos.length < 2) return;
        const video = event.currentTarget;
        if (video !== layerVideo(activeLayer)) return;
        const dur = video.duration;
        if (!dur || !Number.isFinite(dur)) return;
        if (video.currentTime >= Math.max(0.2, dur - LEAD_S)) {
          beginCrossfade();
        }
      }

      function onActiveEnded(event) {
        if (switching || sources.length < 2 || videos.length < 2) return;
        if (event.currentTarget !== layerVideo(activeLayer)) return;
        beginCrossfade();
      }

      videos.forEach((video) => {
        // Marca el src inline para no re-disparar load() en el primer play.
        if (video.getAttribute('src') && !video.dataset.loadedSrc) {
          video.dataset.loadedSrc = video.getAttribute('src');
        }
        video.addEventListener('timeupdate', onActiveProgress);
        video.addEventListener('ended', onActiveEnded);
        cleanups.push(() => {
          video.removeEventListener('timeupdate', onActiveProgress);
          video.removeEventListener('ended', onActiveEnded);
        });
      });

      window.__heroVideoCleanup = () => {
        hero.dataset.heroVideoLive = '';
        timers.forEach((id) => clearTimeout(id));
        cleanups.forEach((fn) => fn());
        videos.forEach((video) => video.pause());
      };

      setActiveLayer(0);

      if (sources.length === 1 || videos.length === 1) {
        layerVideo(0).loop = true;
        playSrc(0, sources[0], { restart: false });
        return;
      }

      videos.forEach((video) => {
        video.loop = false;
      });
      // restart:false — el clip 0 ya viene en el markup; no saltar al frame 0 otra vez.
      playSrc(0, sources[0], { restart: false }).then(preloadNext);
    }

    // page-load cubre SPA; la llamada directa cubre si el script llega tarde.
    // El flag heroVideoLive evita el doble init (reinicio a ~2s) en la carga inicial.
    document.addEventListener('astro:page-load', initHeroVideo);
    initHeroVideo();
  </script>
)}

<style>
  /* Colores literales: evita que un token roto deje el hero crema/negro. */
  .hero {
    --hero-ink: #0c0c0e;
    --hero-cream: #f5f2e8;
    --hero-accent: #b6573e;
    position: relative;
    isolation: isolate;
    /* dvh evita que la barra de URL móvil deje el hero demasiado alto. */
    min-height: min(96vh, 56rem);
    min-height: min(96dvh, 56rem);
    display: flex;
    align-items: flex-end;
    color: var(--hero-cream);
    background: var(--hero-ink);
    overflow: hidden;
  }

  .hero__atmosphere {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 100% 75% at 8% 100%, rgba(182, 87, 62, 0.38), transparent 58%),
      radial-gradient(ellipse 60% 45% at 92% 8%, rgba(245, 242, 232, 0.07), transparent 55%),
      linear-gradient(168deg, #070708 0%, #141210 42%, #1f1a16 100%);
  }

  .hero__atmosphere::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--texture-grain);
    background-size: 180px 180px;
    opacity: 0.28;
    mix-blend-mode: soft-light;
  }

  .hero[data-has-media='true'] .hero__atmosphere {
    opacity: 0.22;
  }

  /* Plano full-bleed: las dos capas de video viven en el mismo rectángulo. */
  .hero__media-frame {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero__media-stack {
    position: absolute;
    inset: -4%;
    animation: hero-media-drift 32s ease-in-out infinite alternate;
    will-change: transform;
  }

  .hero__media,
  .hero__media--still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    pointer-events: none;
  }

  .hero__media--video {
    opacity: 0;
    transition: opacity 1.5s ease;
    filter: saturate(1.28) contrast(1.1);
    animation: hero-media-hue 40s ease-in-out infinite alternate;
    will-change: opacity, filter;
  }

  .hero__media--video.is-active {
    opacity: 1;
  }

  .hero__media-tint {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: color;
    opacity: 0.88;
    animation: hero-field-tint 28s ease-in-out infinite alternate;
  }

  .hero__media-psych {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: soft-light;
    opacity: 0.62;
    animation: hero-psych-wash 22s ease-in-out infinite alternate;
  }

  .hero__media-psych::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--texture-grain);
    background-size: 160px 160px;
    opacity: 0.35;
    mix-blend-mode: overlay;
  }

  @keyframes hero-media-drift {
    0% {
      transform: scale(1.04) translate(0.4%, -0.3%);
    }
    100% {
      transform: scale(1.1) translate(-1.2%, 0.8%);
    }
  }

  @keyframes hero-media-hue {
    0% {
      filter: saturate(1.22) contrast(1.08) hue-rotate(-6deg);
    }
    50% {
      filter: saturate(1.38) contrast(1.12) hue-rotate(14deg);
    }
    100% {
      filter: saturate(1.26) contrast(1.1) hue-rotate(4deg);
    }
  }

  @keyframes hero-field-tint {
    0% {
      background: rgba(36, 78, 58, 0.48);
    }
    50% {
      background: rgba(118, 72, 44, 0.4);
    }
    100% {
      background: rgba(34, 52, 68, 0.44);
    }
  }

  @keyframes hero-psych-wash {
    0% {
      background: rgba(42, 92, 64, 0.55);
    }
    45% {
      background: rgba(182, 87, 62, 0.42);
    }
    100% {
      background: rgba(40, 58, 86, 0.5);
    }
  }

  .hero__credit {
    position: absolute;
    right: clamp(1.25rem, 3.5vw, 2.25rem);
    bottom: clamp(1.35rem, 3.5vh, 2rem);
    bottom: clamp(1.35rem, 3.5dvh, 2rem);
    z-index: 2;
    margin: 0;
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(245, 242, 232, 0.42);
    pointer-events: none;
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(7, 7, 8, 0.14) 0%, rgba(7, 7, 8, 0.22) 38%, rgba(7, 7, 8, 0.78) 100%),
      linear-gradient(105deg, rgba(7, 7, 8, 0.55) 0%, rgba(7, 7, 8, 0.22) 42%, transparent 68%);
  }

  .hero:not([data-has-media='true']) .hero__veil {
    background: transparent;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    width: min(100% - 2.5rem, var(--w-wide, 1120px));
    margin-inline: auto;
    padding-block: clamp(5.5rem, 14vh, 8rem) clamp(4rem, 11vh, 6.5rem);
    padding-block: clamp(5.5rem, 14dvh, 8rem) clamp(4rem, 11dvh, 6.5rem);
    padding-inline: 0.25rem;
    box-sizing: border-box;
  }

  @media (min-width: 960px) {
    .hero__inner {
      /* Empuja el bloque hacia el centro óptico; evita el muro pegado a la izquierda. */
      padding-inline: clamp(2rem, 10vw, 8rem) 0.25rem;
    }
  }

  .hero__copy {
    max-width: 42rem;
    animation: hero-rise 900ms var(--ease-organic, cubic-bezier(0.22, 0.61, 0.36, 1)) both;
  }

  .hero__kicker {
    margin: 0 0 var(--s-4, 1rem);
    padding-left: 0.7rem;
    border-left: 2px solid var(--hero-accent);
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(245, 242, 232, 0.92);
    text-shadow:
      0 1px 2px rgba(7, 7, 8, 0.85),
      0 0 18px rgba(7, 7, 8, 0.45);
  }

  .hero__title {
    margin: 0 0 var(--s-6, 1.5rem);
    font-family: var(--font-serif, "Newsreader", Georgia, serif);
    font-size: clamp(1.85rem, 4.6vw, 3.05rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 18ch;
    color: var(--hero-cream);
  }

  .hero__intro {
    margin: 0 0 var(--s-8, 2rem);
    max-width: 42ch;
    font-family: var(--font-sans, "Instrument Sans", system-ui, sans-serif);
    font-size: clamp(1.02rem, 1.55vw, 1.18rem);
    line-height: 1.65;
    color: rgba(245, 242, 232, 0.78);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 1.4rem;
    font-family: var(--font-sans, "Instrument Sans", system-ui, sans-serif);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      background 180ms ease,
      color 180ms ease,
      border-color 180ms ease;
  }

  .hero__cta--solid {
    background: var(--hero-cream);
    color: var(--hero-ink);
    border-color: var(--hero-cream);
  }

  .hero__cta--solid:hover {
    background: #fff8ea;
    color: var(--hero-ink);
  }

  .hero__cta--ghost {
    background: transparent;
    color: var(--hero-cream);
    border-color: rgba(245, 242, 232, 0.38);
  }

  .hero__cta--ghost:hover {
    border-color: var(--hero-cream);
    background: rgba(245, 242, 232, 0.08);
    color: var(--hero-cream);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(1.15rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__copy {
      animation: none;
    }

    .hero__media-stack,
    .hero__media--video,
    .hero__media-tint,
    .hero__media-psych {
      animation: none;
    }

    .hero__media-tint {
      background: rgba(36, 78, 58, 0.35);
    }

    .hero__media-psych {
      display: none;
    }

    .hero__media--video {
      transition: none;
      filter: none;
    }

    .hero video.hero__media {
      display: none;
    }

    .hero__credit {
      display: none;
    }
  }

  @media (max-width: 639px) {
    .hero {
      /* Deja ver ~15–20% de «Sobre el proyecto» sin scroll. */
      min-height: min(72vh, 34rem);
      min-height: min(72dvh, 34rem);
    }

    .hero__inner {
      width: min(100% - 1.5rem, var(--w-wide, 1120px));
      padding-block: clamp(4.75rem, 12vh, 6.5rem) clamp(2.25rem, 6vh, 3.25rem);
      padding-block: clamp(4.75rem, 12dvh, 6.5rem) clamp(2.25rem, 6dvh, 3.25rem);
    }

    .hero__kicker {
      margin-bottom: 0.75rem;
      font-size: 0.68rem;
    }

    .hero__title {
      max-width: none;
      margin-bottom: 1rem;
      font-size: clamp(1.7rem, 7.2vw, 2.15rem);
      line-height: 1.12;
    }

    .hero__intro {
      margin-bottom: 1.25rem;
      font-size: 0.95rem;
      line-height: 1.55;
      max-width: none;
    }

    .hero__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 0.65rem;
    }

    .hero__cta {
      justify-content: center;
      width: 100%;
      padding: 0.85rem 1.15rem;
    }

    /* Evita que el crédito compita con los CTAs en pantallas cortas. */
    .hero__credit {
      display: none;
    }
  }
</style>
