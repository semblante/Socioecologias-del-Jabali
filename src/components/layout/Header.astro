---
import type { Locale } from '../../config/site';
import { siteConfig } from '../../config/site';
import { getUi } from '../../i18n/ui';
import { localizedPath } from '../../i18n/routing';
import SiteLogo from '../identity/SiteLogo.astro';
import LangSwitch from './LangSwitch.astro';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const ui = getUi(locale);
const menuLabel = locale === 'es' ? 'Abrir menú de navegación' : 'Open navigation menu';
const brand = siteConfig.nameShort[locale];
const place = siteConfig.tagline[locale];

const links = [
  { key: 'proyecto', href: localizedPath('/proyecto', locale), enabled: siteConfig.sections.proyecto },
  { key: 'territorio', href: localizedPath('/territorio', locale), enabled: siteConfig.sections.territorio },
  { key: 'equipo', href: localizedPath('/equipo', locale), enabled: siteConfig.sections.equipo },
  { key: 'bitacora', href: localizedPath('/cuaderno', locale), enabled: siteConfig.sections.bitacora },
  { key: 'archivo', href: localizedPath('/archivo', locale), enabled: siteConfig.sections.archivo },
  { key: 'publicaciones', href: localizedPath('/publicaciones', locale), enabled: siteConfig.sections.publicaciones },
].filter((l) => l.enabled);

function isCurrent(href: string) {
  if (href === '/' || href === '/en/') return currentPath === href || currentPath === href.replace(/\/$/, '');
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-header" transition:persist="site-header">
  <div class="site-header__inner">
    <a href={localizedPath('/', locale)} class="site-brand">
      <SiteLogo locale={locale} size="nav" variant="mark" />
      <span class="site-brand__text">
        <span class="site-brand__name">{brand}</span>
        <span class="site-brand__place">{place}</span>
      </span>
    </a>

    <nav class="site-header__nav" aria-label={locale === 'es' ? 'Navegación principal' : 'Main navigation'}>
      <ul class="site-nav" id="site-nav">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {ui.nav[link.key as keyof typeof ui.nav]}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__end">
      <LangSwitch locale={locale} currentPath={currentPath} />
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label={menuLabel}
        id="menu-toggle"
      >
        <span class="menu-toggle__bar" aria-hidden="true"></span>
        <span class="menu-toggle__bar" aria-hidden="true"></span>
        <span class="menu-toggle__bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    min-width: 0;
  }

  .site-brand:hover {
    color: inherit;
    opacity: 0.85;
  }

  .site-brand__text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
    line-height: 1.15;
  }

  .site-brand__name {
    font-family: var(--font-serif);
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    max-width: 11.5rem;
    line-height: 1.2;
  }

  .site-brand__place {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media (max-width: 959px) {
    .site-brand {
      gap: 0.55rem;
      min-width: 0;
      flex: 1 1 auto;
    }

    .site-brand :global(.site-logo--nav) {
      width: 2.25rem;
      flex-shrink: 0;
    }

    .site-brand__text {
      display: flex;
      min-width: 0;
    }

    .site-brand__name {
      max-width: none;
      font-size: 0.82rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Solo el nombre; el place ocupa demasiado en 375px. */
    .site-brand__place {
      display: none;
    }
  }
</style>
