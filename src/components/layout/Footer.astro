---
import type { Locale } from '../../config/site';
import { siteConfig } from '../../config/site';
import { getUi } from '../../i18n/ui';
import { localizedPath } from '../../i18n/routing';
import SiteLogo from '../identity/SiteLogo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
const showCmsLink = import.meta.env.DEV;

const navLinks = [
  { key: 'proyecto', href: localizedPath('/proyecto', locale) },
  { key: 'equipo', href: localizedPath('/equipo', locale) },
  { key: 'bitacora', href: localizedPath('/bitacora', locale) },
  { key: 'publicaciones', href: localizedPath('/publicaciones', locale) },
  { key: 'contacto', href: localizedPath('/contacto', locale) },
] as const;
---

<footer class="site-footer" transition:persist="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <SiteLogo size="footer" />
      <p class="site-footer__title">{siteConfig.name}</p>
      <p class="site-footer__desc">{siteConfig.projectTitle}</p>
      <p class="kicker site-footer__grant">{siteConfig.fondecyt}</p>
    </div>

    <div>
      <p class="meta" style="margin-bottom: var(--s-4);">{ui.footer.institutions}</p>
      <ul class="site-footer__list">
        {siteConfig.institutions.map((inst) => (
          <li>{inst}</li>
        ))}
      </ul>
    </div>

    <div>
      <p class="meta" style="margin-bottom: var(--s-4);">{ui.footer.navigation}</p>
      <ul class="site-footer__nav">
        {navLinks.map((link) => (
          <li>
            <a href={link.href}>{ui.nav[link.key]}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  {showCmsLink && (
    <div class="container site-footer__meta">
      <hr class="rule-line" />
      <a href="/keystatic" class="site-footer__edit">{ui.footer.editContent}</a>
    </div>
  )}
</footer>
