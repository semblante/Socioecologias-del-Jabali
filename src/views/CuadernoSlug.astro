---
import Article from '../layouts/Article.astro';
import MarkdownBody from '../components/MarkdownBody.astro';
import type { Locale } from '../config/site';
import { getBitacoraBySlug } from '../lib/content';
import { localizedPath } from '../i18n/routing';

interface Props { locale: Locale; slug: string }
const { locale, slug } = Astro.props;
const { entry, isFallback } = await getBitacoraBySlug(slug, locale);
if (!entry) return Astro.redirect(localizedPath('/cuaderno', locale));
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  locale={locale}
  pubDate={entry.data.pubDate}
  tags={entry.data.tags}
  isFallback={isFallback}
  slug={slug}
>
  <MarkdownBody content={entry.content} />
</Article>
