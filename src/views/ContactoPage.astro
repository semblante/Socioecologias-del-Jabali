---
import Base from '../layouts/Base.astro';
import MarkdownBody from '../components/MarkdownBody.astro';
import type { Locale } from '../config/site';
import { getPage } from '../lib/content';
import { getUi } from '../i18n/ui';
import { siteConfig } from '../config/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const ui = getUi(locale);
const page = await getPage('contacto', locale);
---

<Base title={ui.contact.title} description={page?.data.description} locale={locale}>
  <div class="section">
    <div class="container container--narrow">
      <header class="page-header">
        <h1 class="page-header__title">{ui.contact.title}</h1>
      </header>
      {page?.content && <MarkdownBody content={page.content} />}
      <div class="prose">
        <h2>{ui.contact.email}</h2>
        <p><a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a></p>
        <h2>{ui.contact.institutions}</h2>
        <ul>
          {siteConfig.institutions.map((inst) => (
            <li>{inst}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</Base>
