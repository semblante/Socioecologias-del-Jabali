---
import Base from '../layouts/Base.astro';
import MarkdownBody from '../components/MarkdownBody.astro';
import type { Locale } from '../config/site';
import { getPage } from '../lib/content';

interface Props { locale: Locale }
const { locale } = Astro.props;
const page = await getPage('proyecto', locale);
if (!page) throw new Error('Missing proyecto page');
---

<Base title={page.data.title} description={page.data.description} locale={locale}>
  <div class="section">
    <div class="container container--narrow">
      <header class="page-header">
        <h1 class="page-header__title">{page.data.title}</h1>
        {page.data.description && <p class="page-header__lead">{page.data.description}</p>}
      </header>
      <MarkdownBody content={page.content} />
    </div>
  </div>
</Base>
