---
import Base from '../layouts/Base.astro';
import MarkdownBody from '../components/MarkdownBody.astro';
import type { Locale } from '../config/site';
import { getEquipo, getEntrySlug } from '../lib/content';
import { getUi } from '../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const ui = getUi(locale);
const team = await getEquipo(locale);
const investigators = team.filter((m) => m.data.group === 'investigator');
const collaborators = team.filter((m) => m.data.group === 'collaborator');
const students = team.filter((m) => m.data.group === 'tesista');
// Índice arriba: da visibilidad a quienes quedan más abajo en la página.
const roster = [
  { label: ui.equipo.investigators, members: investigators },
  { label: ui.equipo.students, members: students },
  { label: ui.equipo.collaborators, members: collaborators },
].filter((g) => g.members.length > 0);
const anchor = (m: (typeof team)[number]) => `p-${getEntrySlug(m)}`;
---

<Base title={ui.nav.equipo} locale={locale}>
  <div class="section">
    <div class="container container--reading">
      <header class="page-header">
        <h1 class="page-header__title">{ui.nav.equipo}</h1>
        <p class="page-header__lead">
          {locale === 'es'
            ? 'Investigación transdisciplinaria en colaboración con la Asociación Indígena Winkulmapu.'
            : 'Transdisciplinary research in collaboration with the Winkulmapu Indigenous Association.'}
        </p>
      </header>

      <nav class="roster" aria-label={locale === 'es' ? 'Integrantes del equipo' : 'Team members'}>
        {roster.map((group) => (
          <div class="roster__group">
            <p class="roster__label">{group.label}</p>
            <ul class="roster__list">
              {group.members.map((m) => (
                <li>
                  <a class="roster__link" href={`#${anchor(m)}`}>
                    <span class="roster__name">{m.data.name}</span>
                    <span class="roster__role">{m.data.role}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>

      {investigators.length > 0 && (
        <>
          <h2 class="team-heading">{ui.equipo.investigators}</h2>
          <ul class="team-list">
            {investigators.map((member) => (
              <li id={anchor(member)} class:list={['team-row', { 'team-row--lead': member.data.order === 1 }]}>
                <h3 class="team-row__name">
                  {member.data.externalUrl ? (
                    <a href={member.data.externalUrl} target="_blank" rel="noopener noreferrer" class="external-link">
                      {member.data.name}
                      <span class="visually-hidden">{ui.opensNewTab}</span>
                    </a>
                  ) : (
                    member.data.name
                  )}
                </h3>
                <p class="team-row__role">{member.data.role}</p>
                <p class="team-row__aff">{member.data.affiliation}</p>
                <MarkdownBody content={member.content} class="team-row__bio" />
              </li>
            ))}
          </ul>
        </>
      )}

      {students.length > 0 && (
        <>
          <h2 class="team-heading">{ui.equipo.students}</h2>
          <ul class="team-list">
            {students.map((member) => (
              <li id={anchor(member)} class="team-row">
                <h3 class="team-row__name">
                  {member.data.externalUrl ? (
                    <a href={member.data.externalUrl} target="_blank" rel="noopener noreferrer" class="external-link">
                      {member.data.name}
                      <span class="visually-hidden">{ui.opensNewTab}</span>
                    </a>
                  ) : (
                    member.data.name
                  )}
                </h3>
                <p class="team-row__role">{member.data.role}</p>
                <p class="team-row__aff">{member.data.affiliation}</p>
                <MarkdownBody content={member.content} class="team-row__bio" />
              </li>
            ))}
          </ul>
        </>
      )}

      {collaborators.length > 0 && (
        <>
          <h2 class="team-heading">{ui.equipo.collaborators}</h2>
          <ul class="team-list">
            {collaborators.map((member) => (
              <li id={anchor(member)} class="team-row">
                <h3 class="team-row__name">
                  {member.data.externalUrl ? (
                    <a href={member.data.externalUrl} target="_blank" rel="noopener noreferrer" class="external-link">
                      {member.data.name}
                      <span class="visually-hidden">{ui.opensNewTab}</span>
                    </a>
                  ) : (
                    member.data.name
                  )}
                </h3>
                <p class="team-row__role">{member.data.role}</p>
                <p class="team-row__aff">{member.data.affiliation}</p>
                <MarkdownBody content={member.content} class="team-row__bio" />
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  </div>
</Base>

<style>
  .roster {
    display: grid;
    gap: var(--s-8);
    margin-bottom: var(--s-16);
  }

  @media (min-width: 768px) {
    .roster {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
      gap: var(--s-8) var(--s-12);
    }
  }

  .roster__label {
    margin: 0 0 var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .roster__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .roster__list li {
    border-bottom: 1px solid var(--color-border);
  }

  .roster__link {
    position: relative;
    display: grid;
    gap: 0.15rem;
    padding: var(--s-3) 0 var(--s-3);
    color: var(--color-text);
    text-decoration: none;
    transition: padding-left var(--d-medium) var(--ease-organic);
  }

  /* El hilo espectral recorre la regla inferior, como en el menú. */
  .roster__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--spectrum-x);
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 560ms var(--ease-organic);
    will-change: transform;
    backface-visibility: hidden;
  }

  .roster__link:hover,
  .roster__link:focus-visible {
    color: var(--color-text);
    padding-left: var(--s-2);
  }

  .roster__link:hover::after,
  .roster__link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .roster__name {
    font-family: var(--font-display);
    font-stretch: 82%;
    font-weight: 650;
    font-size: 1.12rem;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .roster__role {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* Al llegar desde el índice, el perfil se marca con un filo espectral que se apaga. */
  .team-row {
    position: relative;
    scroll-margin-top: calc(var(--header-h) + var(--s-6));
  }

  .team-row::before {
    content: "";
    position: absolute;
    left: calc(var(--s-6) * -1);
    top: var(--s-8);
    bottom: var(--s-8);
    width: 4px;
    background: var(--spectrum-y);
    opacity: 0;
    pointer-events: none;
  }

  .team-row:target::before {
    animation: roster-target 2.4s var(--ease-organic) both;
  }

  @keyframes roster-target {
    0%,
    55% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 639px) {
    .team-row::before {
      left: calc(var(--s-3) * -1);
      width: 3px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .roster__link,
    .roster__link::after {
      transition: none;
    }
  }

  .team-heading {
    margin: var(--s-16) 0 var(--s-2);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-stretch: 62%;
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    font-weight: 800;
    line-height: 0.9;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .team-heading:first-of-type {
    margin-top: 0;
  }

  .team-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .team-row {
    padding-block: var(--s-8);
    border-bottom: 1px solid var(--color-border);
  }

  .team-row--lead .team-row__name {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  .team-row__name {
    margin: 0 0 var(--s-2);
    font-family: var(--font-display);
    font-stretch: 82%;
    font-weight: 650;
    letter-spacing: -0.012em;
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    line-height: 1.1;
  }

  .team-row__name a {
    color: inherit;
    text-decoration: none;
  }

  .team-row__name a:hover {
    color: var(--color-accent);
  }

  .team-row__role {
    margin: 0;
    font-size: var(--t-sm);
    font-weight: 500;
  }

  .team-row__aff {
    margin: var(--s-1) 0 var(--s-4);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--t-sm);
    color: var(--color-text-muted);
  }

  .team-row__bio {
    font-size: 1rem !important;
    max-width: 58ch;
  }
</style>
