---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import AboutBlurb from '../components/home/AboutBlurb.astro';
import TerritoryTeaser from '../components/home/TerritoryTeaser.astro';
import NewsList from '../components/home/NewsList.astro';
import type { Locale } from '../config/site';
import { getPage, getBitacora } from '../lib/content';
import { getUi } from '../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const ui = getUi(locale);
const home = await getPage('home', locale);
const bitacora = await getBitacora(locale);
const tagline = home?.data.tagline ?? '';
const intro = home?.data.intro ?? '';
const heroMedia = home?.data.heroMedia ?? '';
---

<Base locale={locale}>
  <Hero locale={locale} tagline={tagline} intro={intro} heroMedia={heroMedia} />
  <AboutBlurb locale={locale} summary={ui.homeSummary} />
  <TerritoryTeaser locale={locale} />
  <NewsList locale={locale} entries={bitacora} />
</Base>
