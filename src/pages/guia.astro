---
export const prerender = true;

import guia from '../../docs/cliente.md?raw';
import Base from '../layouts/Base.astro';
import { markdownToHtml } from '../lib/markdown';
import { siteConfig } from '../config/site';

const title = 'Guía para editar el sitio';
const source = guia.replace(/^# .+\r?\n+/, '');
const url = new URL('/guia', siteConfig.url).href;

/**
 * Prepara el HTML de la guía para leerse bien:
 * - cada tabla va en un contenedor con nombre (scroll accesible si no cabe);
 * - cada celda lleva su encabezado en data-label, para apilar filas en móvil;
 * - los avisos («> **…**») se marcan como notas.
 */
function prepare(html: string): string {
  return html
    .replace(/<table>([\s\S]*?)<\/table>/g, (_match, inner: string) => {
      const headers = [...inner.matchAll(/<th[^>]*>([\s\S]*?)<\/th>/g)].map((m) =>
        m[1].replace(/<[^>]+>/g, '').trim(),
      );
      const body = inner.replace(/<tr>([\s\S]*?)<\/tr>/g, (_row, cells: string) => {
        let i = 0;
        const labeled = cells.replace(/<td([^>]*)>/g, (_td, attrs: string) => {
          const label = headers[i++] ?? '';
          return `<td${attrs} data-label="${label.replace(/"/g, '&quot;')}">`;
        });
        return `<tr>${labeled}</tr>`;
      });
      return `<div class="guia__table"><table>${body}</table></div>`;
    })
    .replace(/<blockquote>/g, '<aside class="guia__note">')
    .replace(/<\/blockquote>/g, '</aside>');
}

const html = prepare(markdownToHtml(source));
const sections = [...html.matchAll(/<h2 id="([^"]+)">([\s\S]*?)<\/h2>/g)].map((m) => ({
  id: m[1],
  label: m[2].replace(/<[^>]+>/g, '').replace(/^\d+\.\s*/, ''),
}));
---

<Base
  title={title}
  description="Cómo editar los textos del sitio desde el panel de PocketBase."
  locale="es"
  noindex
  langPaths={{ es: '/guia', en: '/guia' }}
  seo={{ canonical: url, es: url, en: null }}
>
  <div class="section guia">
    <div class="container container--narrow">
      <header class="guia__head">
        <p class="guia__kicker">Uso interno · Panel de contenido</p>
        <h1 class="guia__title">{title}</h1>
      </header>

      {sections.length > 0 && (
        <nav class="guia__toc" aria-label="En esta guía">
          <p class="guia__toc-label">En esta guía</p>
          <ol>
            {sections.map((s) => (
              <li><a href={`#${s.id}`}>{s.label}</a></li>
            ))}
          </ol>
        </nav>
      )}

      <div class="guia__body" set:html={html} />
    </div>
  </div>
</Base>

<style>
  .guia {
    --guia-text: 1.0625rem;
  }

  .guia__head {
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--s-8);
  }

  .guia__kicker {
    margin: 0 0 var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .guia__title {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 82%;
    font-weight: 650;
    font-size: clamp(1.75rem, 3.2vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .guia__toc {
    margin-bottom: var(--s-12);
    padding: var(--s-4) var(--s-6);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
  }

  .guia__toc-label {
    margin: 0 0 var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .guia__toc ol {
    margin: 0;
    padding-left: 1.4em;
    columns: 2;
    column-gap: var(--s-8);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.9;
  }

  .guia__toc a {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.2em;
  }

  .guia__toc a:hover {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  /* Cuerpo: sans legible, renglón corto, ritmo calmo. */
  .guia__body {
    max-width: 68ch;
    font-family: var(--font-sans);
    font-size: var(--guia-text);
    line-height: 1.65;
    color: var(--color-text);
  }

  .guia__body > :global(* + *) {
    margin-top: var(--s-4);
  }

  .guia__body :global(p) {
    margin-bottom: 0;
  }

  .guia__body :global(h2) {
    margin: var(--s-12) 0 var(--s-4);
    padding-top: var(--s-6);
    border-top: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-stretch: 82%;
    font-weight: 650;
    font-size: var(--t-xl);
    line-height: 1.15;
    letter-spacing: -0.01em;
    scroll-margin-top: calc(var(--header-h) + var(--s-4));
  }

  .guia__body :global(h2:first-child) {
    margin-top: 0;
  }

  .guia__body :global(h3) {
    margin: var(--s-8) 0 var(--s-3);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--t-md);
    line-height: 1.3;
  }

  .guia__body :global(ol),
  .guia__body :global(ul) {
    padding-left: 1.5em;
  }

  .guia__body :global(li + li) {
    margin-top: var(--s-2);
  }

  .guia__body :global(li::marker) {
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .guia__body :global(strong) {
    font-weight: 600;
  }

  .guia__body :global(a) {
    color: var(--color-accent);
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .guia__body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    padding: 0.08em 0.4em;
    background: var(--color-bg-card);
    white-space: nowrap;
  }

  /* Notas: recuadro plano, sin cursiva. */
  .guia__body :global(.guia__note) {
    margin: var(--s-6) 0;
    padding: var(--s-3) var(--s-4);
    background: var(--color-accent-subtle);
    border-left: 3px solid var(--color-accent);
  }

  .guia__body :global(.guia__note p) {
    margin: 0;
  }

  /* Tablas: ancho completo, encabezado claro, filas separadas. */
  .guia__body :global(.guia__table) {
    margin: var(--s-4) 0 var(--s-6);
    overflow-x: auto;
  }

  .guia__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .guia__body :global(th) {
    padding: var(--s-2) var(--s-3);
    text-align: left;
    vertical-align: bottom;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border-bottom: 2px solid var(--color-text);
    white-space: nowrap;
  }

  .guia__body :global(td) {
    padding: var(--s-3);
    vertical-align: top;
    border-bottom: 1px solid var(--color-border);
  }

  .guia__body :global(td:first-child) {
    font-weight: 500;
    width: 38%;
    min-width: 12rem;
  }

  .guia__body :global(tbody tr:nth-child(even)) {
    background: rgba(255, 255, 255, 0.28);
  }

  /* Campos múltiples: que puedan saltar de línea entre comas. */
  .guia__body :global(td:last-child code) {
    white-space: normal;
  }

  /* Móvil: cada fila se vuelve una ficha con sus etiquetas. */
  @media (max-width: 639px) {
    .guia__toc ol {
      columns: 1;
    }

    .guia__body :global(.guia__table) {
      overflow: visible;
    }

    .guia__body :global(thead) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .guia__body :global(table),
    .guia__body :global(tbody),
    .guia__body :global(tr),
    .guia__body :global(td) {
      display: block;
      width: 100%;
    }

    .guia__body :global(tr) {
      padding: var(--s-3) 0;
      border-bottom: 1px solid var(--color-border);
    }

    .guia__body :global(tbody tr:nth-child(even)) {
      background: none;
    }

    .guia__body :global(td) {
      position: relative;
      padding: var(--s-1) 0 var(--s-1) 7rem;
      border: 0;
    }

    .guia__body :global(td::before) {
      content: attr(data-label);
      position: absolute;
      left: 0;
      top: var(--s-1);
      width: 6.5rem;
      font-family: var(--font-mono);
      font-size: var(--t-xs);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--color-text-muted);
      padding-top: 0.2em;
    }

    .guia__body :global(td:first-child) {
      min-width: 0;
      font-size: 1rem;
    }
  }
</style>
