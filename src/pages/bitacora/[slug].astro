---
import Article from '../../layouts/Article.astro';
import { getBitacoraBySlug } from '../../lib/content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const all = await getCollection('bitacora');
  return all
    .filter((e) => e.data.locale === 'es')
    .map((entry) => ({
      params: { slug: entry.id.split('/').pop()! },
    }));
}

const locale = 'es';
const { slug } = Astro.params;
const { entry, isFallback } = await getBitacoraBySlug(slug!, locale);
if (!entry) return Astro.redirect('/bitacora');

const { Content } = await render(entry);
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  locale={locale}
  pubDate={entry.data.pubDate}
  tags={entry.data.tags}
  isFallback={isFallback}
  slug={slug}
>
  <Content />
</Article>
