---
import Article from '../../../layouts/Article.astro';
import { getBitacoraBySlug } from '../../../lib/content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const all = await getCollection('bitacora');
  const esSlugs = all.filter((e) => e.data.locale === 'es').map((e) => e.id.split('/').pop()!);
  const enOnly = all
    .filter((e) => e.data.locale === 'en')
    .map((e) => e.id.split('/').pop()!)
    .filter((s) => !esSlugs.includes(s));

  return [...esSlugs, ...enOnly].map((slug) => ({ params: { slug } }));
}

const locale = 'en';
const { slug } = Astro.params;
const { entry, isFallback } = await getBitacoraBySlug(slug!, locale);
if (!entry) return Astro.redirect('/en/bitacora');

const { Content } = await render(entry);
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  locale={locale}
  pubDate={entry.data.pubDate}
  tags={entry.data.tags}
  isFallback={isFallback}
  slug={slug}
>
  <Content />
</Article>
