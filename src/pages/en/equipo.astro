---
import Base from '../../layouts/Base.astro';
import { getEquipo } from '../../lib/content';
import { getUi } from '../../i18n/ui';
import { render } from 'astro:content';

const locale = 'en';
const ui = getUi(locale);
const team = await getEquipo(locale);
const investigators = team.filter((m) => m.data.group === 'investigator');
const collaborators = team.filter((m) => m.data.group === 'collaborator');
---

<Base title={ui.nav.equipo} locale={locale}>
  <div class="section">
    <div class="container container--reading">
      <header class="page-header">
        <h1 class="page-header__title">{ui.nav.equipo}</h1>
      </header>

      <h2 class="section__title" style="font-size: var(--t-xl);">{ui.equipo.investigators}</h2>
      <div class="grid-cards" style="margin-bottom: var(--s-16);">
        {await Promise.all(
          investigators.map(async (member) => {
            const { Content } = await render(member);
            const isLead = member.data.order === 1;
            return (
              <article class:list={['team-card', { 'team-card--lead': isLead }]}>
                <h3 class="team-card__name">
                  {member.data.externalUrl ? (
                    <a
                      href={member.data.externalUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="external-link"
                    >
                      {member.data.name}
                      <span class="visually-hidden">{ui.opensNewTab}</span>
                    </a>
                  ) : (
                    member.data.name
                  )}
                </h3>
                <p class="team-card__role">{member.data.role}</p>
                <p class="team-card__affiliation">{member.data.affiliation}</p>
                <div class="prose" style="font-size: var(--t-sm);">
                  <Content />
                </div>
              </article>
            );
          }),
        )}
      </div>

      <h2 class="section__title" style="font-size: var(--t-xl);">{ui.equipo.collaborators}</h2>
      <div class="grid-cards">
        {await Promise.all(
          collaborators.map(async (member) => {
            const { Content } = await render(member);
            return (
              <article class="team-card">
                <h3 class="team-card__name">{member.data.name}</h3>
                <p class="team-card__role">{member.data.role}</p>
                <p class="team-card__affiliation">{member.data.affiliation}</p>
                <div class="prose" style="font-size: var(--t-sm);">
                  <Content />
                </div>
              </article>
            );
          }),
        )}
      </div>
    </div>
  </div>
</Base>
