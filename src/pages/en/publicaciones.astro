---
import Base from '../../layouts/Base.astro';
import { getPublicaciones } from '../../lib/content';
import { getUi } from '../../i18n/ui';

const locale = 'en';
const ui = getUi(locale);
const pubs = await getPublicaciones(locale);
---

<Base title={ui.nav.publicaciones} locale={locale}>
  <div class="section">
    <div class="container container--narrow">
      <header class="page-header">
        <h1 class="page-header__title">{ui.nav.publicaciones}</h1>
        <p class="page-header__lead">{ui.publicaciones.lead}</p>
      </header>

      <div class="pub-filters" role="group" aria-label={ui.publicaciones.filterLabel}>
        <button type="button" class="pub-filter" data-filter="all" aria-pressed="true">{ui.pub.filterAll}</button>
        <button type="button" class="pub-filter" data-filter="article" aria-pressed="false">{ui.pub.filterArticle}</button>
        <button type="button" class="pub-filter" data-filter="chapter" aria-pressed="false">{ui.pub.filterChapter}</button>
        <button type="button" class="pub-filter" data-filter="book" aria-pressed="false">{ui.pub.filterBook}</button>
        <button type="button" class="pub-filter" data-filter="report" aria-pressed="false">{ui.pub.filterReport}</button>
      </div>

      <div class="pub-list">
        {pubs.map((pub) => (
          <article class="pub-item" data-type={pub.data.type}>
            <p class="pub-item__year">{pub.data.year}</p>
            <h2 class="pub-item__title">
              {pub.data.url ? (
                <a href={pub.data.url} target="_blank" rel="noopener noreferrer" class="external-link">
                  {pub.data.title}
                  <span class="visually-hidden">{ui.opensNewTab}</span>
                </a>
              ) : (
                pub.data.title
              )}
            </h2>
            <p class="pub-item__authors">{pub.data.authors}</p>
            <p class="pub-item__venue">
              <em>{pub.data.venue}</em>
              {pub.data.doi && (
                <span class="pub-item__doi">
                  {' '}
                  · <a href={`https://doi.org/${pub.data.doi}`}>DOI: {pub.data.doi}</a>
                </span>
              )}
            </p>
          </article>
        ))}
      </div>
    </div>
  </div>
</Base>
