---
import '../styles/base.css';
import { ClientRouter } from 'astro:transitions';
import type { Locale } from '../config/site';
import { siteConfig } from '../config/site';
import { getUi } from '../i18n/ui';
import { localizedPath, getLocaleFromUrl } from '../i18n/routing';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { surfaceFromPath, topoFromPath, topoStyle } from '../lib/surface';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import newsreaderLatin from '@fontsource/newsreader/files/newsreader-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  ogImage?: string;
}

const { title, description, locale: propLocale, ogImage } = Astro.props;
const locale = propLocale ?? getLocaleFromUrl(Astro.url);
const ui = getUi(locale);
const pageTitle = title ? `${title} · ${siteConfig.name}` : siteConfig.name;
const pageDescription =
  description ??
  (locale === 'es'
    ? 'Investigación Fondecyt sobre socioecologías del jabalí en la Araucanía Andina como zona de contacto entre mundos humanos y no humanos.'
    : 'Fondecyt research on wild boar socioecologies in the Andean Araucanía as a contact zone between human and nonhuman worlds.');
const canonical = new URL(Astro.url.pathname, siteConfig.url).href;
const ogImageUrl = new URL(ogImage ?? '/brand/icon-512.png', siteConfig.url).href;
const pathSansLocale = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const isHome = pathSansLocale === '/' || pathSansLocale === '';
const surface = surfaceFromPath(Astro.url.pathname);
const topo = topoFromPath(Astro.url.pathname);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ResearchProject',
  name: siteConfig.name,
  alternateName: siteConfig.nameShort.en,
  description: pageDescription,
  url: siteConfig.url,
  identifier: siteConfig.fondecyt,
  startDate: '2026',
  funder: {
    '@type': 'Organization',
    name: 'ANID / Fondecyt',
  },
  parentOrganization: {
    '@type': 'CollegeOrUniversity',
    name: 'Pontificia Universidad Católica de Chile',
  },
};
---

<!doctype html>
<html lang={locale} data-intro={siteConfig.intro} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsreaderLatin} as="font" type="font/woff2" crossorigin />
    <!--
      Guardián de fuentes: el texto espera a que carguen las tipografías (sin
      salto de fuente) y entra con transición. Tope de 1,2 s tras el parseo y 8 s
      absolutos: nunca queda oculto.
    -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        // Al navegar, client-nav trae el <head> nuevo y este script vuelve a
        // correr. Si las fuentes ya están, no hay nada que esperar: sin este
        // corte ocultaba el contenido hasta el seguro de 8 s.
        if (d.classList.contains('fonts-ready')) return;
        d.classList.add('fonts-pending');
        var shown = false;
        function show() {
          if (shown) return;
          shown = true;
          d.classList.remove('fonts-pending');
          d.classList.add('fonts-ready');
        }
        // Seguro absoluto por si algo falla: el texto nunca queda oculto.
        setTimeout(show, 8000);
        // Todo lo demás espera al fin del parseo: el cuerpo llega en streaming y
        // los títulos se dividen en letras (letters.ts) justo antes de este evento.
        // Mostrar antes dejaba ver el título entero, que luego se ocultaba.
        document.addEventListener('DOMContentLoaded', function () {
          setTimeout(show, 1200);
          if (!document.fonts || !document.fonts.load) return show();
          Promise.all([
            '800 1em "Archivo Variable"',
            '400 1em "Newsreader"',
            'italic 400 1em "Newsreader"',
            '500 1em "Instrument Sans"',
            '400 1em "Geist Mono Variable"',
          ].map(function (f) { return document.fonts.load(f); })).then(show, show);
        });
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL(localizedPath(pathSansLocale, 'es'), siteConfig.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(localizedPath(pathSansLocale, 'en'), siteConfig.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath(pathSansLocale, 'es'), siteConfig.url).href} />
    <link rel="apple-touch-icon" href="/brand/icon-180.png" />
    <meta property="og:locale" content={locale === 'es' ? 'es_CL' : 'en_US'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <ClientRouter />
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ 'is-home': isHome, [`surface-${surface}`]: true }}>
    <!-- Dos capas: la activa se ve; la otra recibe el relieve siguiente y se funde encima. -->
    <div class="site-topo is-active" aria-hidden="true" data-topo-layer data-topo-key={topo.key} style={topoStyle(topo)}></div>
    <div class="site-topo" aria-hidden="true" data-topo-layer></div>
    <a class="skip-link" href="#main">{ui.skipToContent}</a>
    <Header locale={locale} currentPath={Astro.url.pathname} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script src="../scripts/client-nav.ts"></script>
    <script src="../scripts/site-nav.ts"></script>
    <script src="../scripts/pub-filters.ts"></script>
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/letters.ts"></script>
  </body>
</html>
