# Keystatic — solo necesario en producción con GitHub
# Formato: usuario-o-org/nombre-repo (PUBLIC_ porque el panel lo lee en el navegador)
PUBLIC_KEYSTATIC_GITHUB_REPO=

# OAuth App de GitHub (https://github.com/settings/developers)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Secreto aleatorio para sesiones del panel de edición
KEYSTATIC_SECRET=genera-un-secreto-largo-aqui
